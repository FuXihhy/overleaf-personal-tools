{
  "manifest_version": 3,
  "name": "Overleaf Personal Tools",
  "version": "0.12.17",
  "version_name": "0.12.17 Windows development",
  "description": "\u9879\u76ee\u5b8f\u5305\u4e0e\u81ea\u5b9a\u4e49\u547d\u4ee4\u8865\u5168\u3001\u516c\u5f0f\u9884\u89c8\u3001\u9009\u533a\u4e0e\u9879\u76ee\u4e0a\u4e0b\u6587 Codex \u95ee\u7b54\u3002\u8bbe\u7f6e\u96c6\u6210\u5728 Overleaf \u539f\u751f\u8bbe\u7f6e\u7a97\u53e3\u4e2d\u3002",
  "minimum_chrome_version": "145",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": ["https://www.overleaf.com/project/*", "https://cn.overleaf.com/project/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "js": [
        "editor-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "renderer.js",
        "cloud-pdf.js",
        "pdf-standard-fonts/*",
        "assets/zero-two-avatar.png",
        "assets/codex-app.png"
      ],
      "matches": [
        "https://www.overleaf.com/*",
        "https://cn.overleaf.com/*"
      ]
    }
  ],
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "api-settings.html",
    "open_in_tab": true
  }
}
