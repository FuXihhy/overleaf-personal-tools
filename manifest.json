{
  "manifest_version": 3,
  "name": "Overleaf Personal Tools",
  "version": "0.12.18",
  "description": "项目宏包与自定义命令补全、公式预览、选区与项目上下文 Codex 问答。设置集成在 Overleaf 原生设置窗口中。",
  "minimum_chrome_version": "145",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://www.overleaf.com/project/*",
    "https://cn.overleaf.com/project/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "js": [
        "editor-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://cn.overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "renderer.js",
        "cloud-pdf.js",
        "pdf-standard-fonts/*",
        "assets/zero-two-avatar.png",
        "assets/codex-app.png"
      ],
      "matches": [
        "https://www.overleaf.com/*",
        "https://cn.overleaf.com/*"
      ]
    }
  ],
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "api-settings.html",
    "open_in_tab": true
  }
}
